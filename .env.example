# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/todo_chatbot_dev
DB_POOL_SIZE=5
DB_POOL_MAX_OVERFLOW=10

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
API_PREFIX=/api

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Agent Configuration
AGENT_NAME=TodoAgent
AGENT_DESCRIPTION=An AI assistant for managing your todo list

# MCP Server Configuration
MCP_SERVER_URL=http://localhost:8000
REQUEST_TIMEOUT=30

# Authentication Configuration
AUTH_JWT_SECRET=your_jwt_secret_here
AUTH_COOKIE_NAME=__Secure-authjs.session-token
AUTH_BASE_URL=http://localhost:3000/api/auth
SESSION_EXPIRY_HOURS=24
SECURE_COOKIES=true
CSRF_PROTECTION=true

# Better Auth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_here

# Frontend Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# Debug Mode
DEBUG=true